{
  "openapi": "3.1.0",
  "info": {
    "title": "Radiology VQA Multimodal Agent — Rule-Based Demo API",
    "version": "3.0.0",
    "description": "Generic numerical/descriptor rule evaluation. No image analysis, patient decision support, validated thresholds, or real language-model inference."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Status and metadata JSON"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory counters (JSON, not Prometheus text)",
        "responses": {
          "200": {
            "description": "JSON counts"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate a synthetic task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "description": "Synthetic task ID"
                  },
                  "target_identifier": {
                    "type": "string",
                    "description": "Synthetic target ID"
                  },
                  "primary_metric": {
                    "type": "number",
                    "description": "Illustrative threshold: 25"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0,
                    "description": "Illustrative threshold: 12"
                  },
                  "status_descriptor": {
                    "type": "string",
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule-based dossier"
          },
          "400": {
            "description": "Potential identifier detected"
          },
          "422": {
            "description": "Input validation error"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "400": {
            "description": "Potential identifier detected"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Inspect volatile audit chain",
        "responses": {
          "200": {
            "description": "Audit block metadata and chain-verification result"
          }
        }
      }
    }
  }
}
